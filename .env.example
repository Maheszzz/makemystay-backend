# Copy to .env for local development:
#   cp .env.example .env
#
# Never commit .env or put real credentials in .env.example.
# Production environment variables are managed on the EC2/container host.

# --- Database (Required) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=your_local_db_password
DB_NAME=makemystay

# --- Application Environment ---
ENV=development
SITE_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# Optional: comma-separated extra CORS origins (localhost is allowed automatically in development)
# CORS_EXTRA_ORIGINS=https://staging-admin.example.com

# Optional: run SQLAlchemy create_all on API startup (fresh local DB only; production uses Alembic)
# SQLALCHEMY_CREATE_ALL_ON_STARTUP=false
# SQLALCHEMY_ECHO=false

# --- Authentication (Required) ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Email / SMTP (Required by Settings) ---
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=MakeMyStay

# --- Frontend ISR Cache Revalidation (Optional) ---
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# --- Razorpay (Optional locally, required for payment endpoints) ---
# Max single checkout amount (rupees). Booking orders that send property_type are checked against the fee table.
PAYMENT_MAX_AMOUNT_INR=200000
# Set true once the public checkout always sends property_type/service_fee_type for "booking" payments.
PAYMENT_REQUIRE_FEE_TABLE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Background Scheduler & Lead Sync ---
# Keep false locally unless testing scheduled jobs
RUN_SCHEDULER=false
LEAD_PULL_SYNC_ENABLED=false

# --- AWS S3 & CloudFront (Optional locally, required for media uploads) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=
# CLOUDFRONT_DOMAIN=
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# S3_VERIFY_UPLOAD_CONTENT_TYPE_WITH_HEAD=false
# S3_HEAD_VERIFY_OVERRIDE_DB_FROM_S3=true
# S3_HEAD_MISMATCH_STRICT=false
# S3_HEAD_MISMATCH_DELETE_OBJECT=false
# S3_HEAD_DELETE_REQUIRES_DOUBLE_CONFIRM=true
# S3_HEAD_MAX_ATTEMPTS=3
# S3_HEAD_RETRY_BASE_SECONDS=0.5
# S3_VERIFY_MAGIC_FROM_BYTES=false
# S3_MAGIC_RANGE_BYTES=8192
# ALERT_WEBHOOK_URL=
# S3_ORPHAN_CLEANUP_ENABLED=false
# S3_ORPHAN_CLEANUP_DRY_RUN=true
# S3_ORPHAN_CLEANUP_MIN_AGE_HOURS=48
# S3_ORPHAN_CLEANUP_MIN_AGE_MINUTES=0
# S3_ORPHAN_CLEANUP_MAX_DELETES_PER_RUN=500
# S3_ORPHAN_CLEANUP_ALERT_DELETES_THRESHOLD=100
# S3_ORPHAN_CLEANUP_CRON_HOUR_UTC=3
# S3_ORPHAN_CLEANUP_CRON_MINUTE_UTC=15

# --- Realty CRM Contact Webhook (Optional) ---
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=

# --- Retell AI (Optional) ---
# RETELL_API_KEY=
# RETELL_AGENT_ID=
# RETELL_FROM_NUMBER=

# --- Twilio WhatsApp (Optional) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_TEMPLATE_SID=
# TWILIO_WHATSAPP_FALLBACK_TEMPLATE_SID=

# --- Meta WhatsApp Cloud (Optional) ---
# WHATSAPP_TOKEN=
# PHONE_NUMBER_ID=
# VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v18.0

# --- Legacy / External CRM & Lead Portal Settings (Preserved for compatibility) ---
# HOUSING_API_KEY=
# HOUSING_API_ID=
# HOUSING_WEBHOOK_API_KEY=
# ACRES_API_KEY=
# ZOHO_CRM_CLIENT_ID=
# ZOHO_CRM_CLIENT_SECRET=
# ZOHO_CRM_REFRESH_TOKEN=
