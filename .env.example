DB_HOST=127.0.0.1
# Local dev (Docker / Workbench “MakeMyStayRealty Dev”): host port 3336 → container 3306 is common.
# Production (.env.production) uses 3306 for RDS; override locally with .env.production.local — see comment below.
DB_PORT=3336
DB_USER=appuser
DB_PASSWORD=your_strong_password
DB_NAME=makemystay
ENV=development

# Optional: local uvicorn port — scripts/dev.sh uses PORT (default 8000), e.g. PORT=8001 ./scripts/dev.sh

# Optional: print every SQL statement (noisy). Default off.
# SQLALCHEMY_ECHO=true

# If ENV=production, .env.production sets DB_PORT=3306 (RDS). For local MySQL on 3336, copy
# .env.production.local.example to .env.production.local with DB_PORT=3336 (gitignored).
# Or set ENV=development in .env.local so .env.production is not loaded.

# Optional: comma-separated extra CORS origins (staging admin, etc.). Localhost is covered via regex in main.py.
# CORS_EXTRA_ORIGINS=https://staging-admin.example.com

# Optional: run SQLAlchemy create_all on API startup (fresh local DB only). Production uses Alembic.
# SQLALCHEMY_CREATE_ALL_ON_STARTUP=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=MakeMyStayRealty

# Housing/99acres lead pull (APScheduler). Default in code is false for local uvicorn.
# Production (PM2) sets LEAD_PULL_SYNC_ENABLED=true in ecosystem.config.js.
# Optional for local: LEAD_PULL_SYNC_ENABLED=false  (also in .env.production.local)
LEAD_PULL_SYNC_ENABLED=false

# Housing.com CRM Integration
HOUSING_API_KEY=your_housing_hmac_secret_key
HOUSING_API_ID=your_housing_account_id
HOUSING_PROJECT_IDS=

# Zoho CRM — daily API guard (Redis counter per UTC day). 0 = disables limits (local dev without Redis).
# When budget > 0 and Redis is down, Zoho calls are blocked (fail-safe).
# ZOHO_DAILY_API_BUDGET=10000
# ZOHO_DAILY_API_SOFT_LIMIT_RATIO=0.8
# ZOHO_SYNC_IDEMPOTENCY_SECONDS=120
# ZOHO_PROCESSING_STALE_SECONDS=300

# Celery default-queue depth alert (requires: celery -A app.core.celery_app beat)
# CELERY_QUEUE_BACKLOG_ALERT_THRESHOLD=1000
# CELERY_BACKPRESSURE_DELAY_SECONDS=120

# Zoho circuit breaker (rolling failure ratio in Redis; pause outbound CRM when high)
# ZOHO_CIRCUIT_FAILURE_RATIO=0.5
# ZOHO_CIRCUIT_PAUSE_SECONDS=300

# GET /api/v1/internal/zoho-status and POST .../zoho-dlq/reprocess/{id} — require header X-Internal-Token
# INTERNAL_METRICS_TOKEN=generate-a-long-random-secret
