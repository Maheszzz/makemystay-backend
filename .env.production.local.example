# Copy to .env.production.local (gitignored) when ENV=production but MySQL listens on a non-RDS port
# (e.g. Docker publishing 3336:3306). This file loads after .env.production and overrides DB_PORT.
DB_PORT=3336

# Local machine: turn off Housing/99acres pull sync (stops MySQL spam + frees pool for GET /realty/properties).
LEAD_PULL_SYNC_ENABLED=false
