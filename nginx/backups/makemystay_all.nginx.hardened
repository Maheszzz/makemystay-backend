# Unified Nginx Config for makemystay.ai
# Handling Main Site, Admin Portal, and API Subdomain separately
# After edits: sudo nginx -t && sudo systemctl reload nginx

gzip on;
gzip_vary on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/ld+json
    application/xml
    application/rss+xml
    image/svg+xml
    font/woff2;

brotli on;
brotli_comp_level 5;
brotli_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/ld+json
    application/xml
    image/svg+xml
    font/woff2;

etag on;
open_file_cache max=20000 inactive=60s;
open_file_cache_valid 120s;
open_file_cache_min_uses 2;
open_file_cache_errors on;

# --- www → apex redirect ---
server {
    listen 80;
    server_name www.makemystay.ai;

    # Health Check Endpoint for ALB (keep it here too just in case)
    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    return 301 https://makemystay.ai$request_uri;
}

# Main Website (Primary Domain)
server {
    listen 80;
    server_name makemystay.ai;

    root /var/www/react-app;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()" always;

    # Health Check Endpoint for ALB
    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    # Hashed JS/CSS — never fall back to index.html
    location /assets/ {
        root /var/www/react-app;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Vary "Accept-Encoding" always;
        access_log off;
    }

    location ~* \.(?:woff2?|ttf|otf)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
        access_log off;
    }

    location ~* \.(?:avif|webp|png|jpg|jpeg|gif|svg|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" always;
        access_log off;
    }

    # Vite public/ files at site root
    location ~* ^/[^/]+\.(json|webmanifest|txt|xml)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
        add_header Vary "Accept-Encoding" always;
    }

    location = /index.html {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Link "<https://api.makemystay.ai>; rel=preconnect, <https://api.makemystay.ai>; rel=dns-prefetch" always;
    }

    # Proxy /api/* to FastAPI backend
    location /api/ {
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_buffers 16 32k;
        proxy_busy_buffers_size 64k;
        
        # 🔥 CRITICAL AUTH FIX: Ensure Authorization header is passed to FastAPI
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }

    # SPA routing — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Admin Portal (Dedicated Subdomain)
server {
    listen 80;
    server_name admin.makemystay.ai;

    root /var/www/makemystay-admin/current;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()" always;

    # Health Check Endpoint for ALB
    location = /health {
        access_log off;
        return 200 'healthy\n';
        add_header Content-Type text/plain;
    }

    # Live admin events (WebSocket)
    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Proxy /api/* to FastAPI backend (26m: admin uploads PDFs up to 25 MB)
    location /api/ {
        client_max_body_size 26m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 🔥 CRITICAL AUTH FIX: Ensure Authorization header is passed to FastAPI
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }

    location /assets/ {
        root /var/www/makemystay-admin/current;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Vary "Accept-Encoding" always;
        access_log off;
    }

    location ~* \.(?:avif|webp|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" always;
        access_log off;
    }

    # Prevent stale HTML during rolling deploys.
    location = /index.html {
        try_files $uri =404;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API Subdomain (Dedicated Subdomain)
server {
    listen 80;
    server_name api.makemystay.ai;

    client_max_body_size 26m;

    # Prometheus metrics: internal only
    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_buffers 16 32k;
        proxy_busy_buffers_size 64k;
        
        # 🔥 CRITICAL AUTH FIX: Ensure Authorization header is passed to FastAPI
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
    }
}
